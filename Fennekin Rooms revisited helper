-- Local Locker Transparency System
local currentLockerParts = {}

local function resetLockerTransparency()
    for part, originalVal in pairs(currentLockerParts) do
        if part and part:IsA("BasePart") then
            part.LocalTransparencyModifier = originalVal
        end
    end
    table.clear(currentLockerParts)
end

RunService.RenderStepped:Connect(function()
    if not isTransparentLockerEnabled then
        if next(currentLockerParts) ~= nil then
            resetLockerTransparency()
        end
        return
    end

    local character = LocalPlayer.Character
    if not character then
        resetLockerTransparency()
        return
    end

    local hrp = character:FindFirstChild("HumanoidRootPart")
    if not hrp then
        resetLockerTransparency()
        return
    end

    local foundLockerModel = nil
    local minDistance = 6

    for _, obj in ipairs(Workspace:GetDescendants()) do
        if obj:IsA("Model") then
            local nameLower = obj.Name:lower()
            if string.find(nameLower, "locker") or string.find(nameLower, "cabinet") or string.find(nameLower, "closet") or string.find(nameLower, "armario") then
                local pivot = obj:GetPivot().Position
                local dist = (hrp.Position - pivot).Magnitude
                if dist < minDistance then
                    minDistance = dist
                    foundLockerModel = obj
                end
            end
        end
    end

    if foundLockerModel then
        for _, descendant in ipairs(foundLockerModel:GetDescendants()) do
            if descendant:IsA("BasePart") and descendant.Name ~= "HumanoidRootPart" then
                if currentLockerParts[descendant] == nil then
                    currentLockerParts[descendant] = descendant.LocalTransparencyModifier
                end
                descendant.LocalTransparencyModifier = 0.8
            end
        end
    else
        if next(currentLockerParts) ~= nil then
            resetLockerTransparency()
        end
    end
end)

-- ESP System
local espFolder = Instance.new("Folder")
espFolder.Name = "RoomsESPFolder"
espFolder.Parent = CoreGui

local activeHighlights = {}

local function clearESP()
    espFolder:ClearAllChildren()
    table.clear(activeHighlights)
end

local function applyHighlight(target, color, fillAlpha)
    if not target then return end
    
    if activeHighlights[target] and activeHighlights[target].Parent then
        activeHighlights[target].FillColor = color
        return
    end

    local highlight = Instance.new("Highlight")
    highlight.Name = "ESPHighlight"
    highlight.Adornee = target
    highlight.FillColor = color
    highlight.FillTransparency = fillAlpha or 0.5
    highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
    highlight.OutlineTransparency = 0.2
    highlight.Parent = espFolder
    
    activeHighlights[target] = highlight

    target.AncestryChanged:Connect(function(_, parent)
        if not parent and activeHighlights[target] then
            activeHighlights[target]:Destroy()
            activeHighlights[target] = nil
        end
    end)
end

local function updateESP()
    if not isEspEnabled then return end

    for _, obj in ipairs(Workspace:GetDescendants()) do
        if obj:IsA("Model") or obj:IsA("BasePart") then
            local nameLower = obj.Name:lower()
            
            -- Doors (Blue)
            if string.find(nameLower, "door") or string.find(nameLower, "porta") or string.find(nameLower, "gateway") then
                applyHighlight(obj, Color3.fromRGB(0, 150, 255), 0.6)
            
            -- Lockers / Cabinets
            elseif string.find(nameLower, "locker") or string.find(nameLower, "cabinet") or string.find(nameLower, "closet") or string.find(nameLower, "armario") then
                local hasEntityInside = false
                for _, child in ipairs(obj:GetDescendants()) do
                    if isEntity(child) or string.find(child.Name:lower(), "mimic") or string.find(child.Name:lower(), "hide") or string.find(child.Name:lower(), "entity") then
                        hasEntityInside = true
                        break
                    end
                end
                
                if hasEntityInside then
                    applyHighlight(obj, Color3.fromRGB(255, 0, 0), 0.2) -- Red (Danger)
                else
                    applyHighlight(obj, Color3.fromRGB(0, 255, 100), 0.5) -- Green (Safe)
                end
            end
        end
    end
end

task.spawn(function()
    while true do
        if isEspEnabled then
            updateESP()
        end
        task.wait(1)
    end
end)

