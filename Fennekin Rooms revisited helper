-- Entity List (Rooms: Revisited)
local entityNames = {
    "A-15", "A-20", "A-25", "A-60", "A-60b", "A-70", "A-85", "A-90", "A-90b", "A-110", "A-120", 
    "A-123", "A-181", "A-200", "A-223", "A-275", "A-305", "A-330",
    "A+15", "A+33", "A+60", "B-1", "B-225",
