-- Notification Function
local function notify(title, text)
    StarterGui:SetCore("SendNotification", {
        Title = title,
        Text = text,
        Duration = 5
    })
end

local function isEntity(child)
    local childNameLower = child.Name:lower()
    return entityLookup[childNameLower] or string.find(childNameLower, "entity") or string.find(childNameLower, "monster")
end

local function isA90(child)
    local nameLower = child.Name:lower()
    return string.find(nameLower, "a-90") or string.find(nameLower, "a90") or string.find(nameLower, "a+90")
end

-- Spawn, Despawn and Anti A-90 Detector
Workspace.ChildAdded:Connect(function(child)
    if isAntiA90Enabled and isA90(child) then
        pcall(function()
            child:Destroy()
        end)
        notify("🛡️ ANTI A-90", "A-90 / Variant blocked and deleted successfully!")
        return
    end

    if isDetectorEnabled and isEntity(child) then
        notify("⚠️ ENTITY DETECTED!", "The entity " .. child.Name .. " just spawned!")
    end
end)

Workspace.ChildRemoved:Connect(function(child)
    if isDetectorEnabled and isEntity(child) and not isA90(child) then
        notify("✅ SAFE!", "The entity " .. child.Name .. " has despawned.")
    end
end)

